# Copy to .env (git-ignored) and fill in the keys you have. Engines without a
# key show up in the app as "no key on proxy".

PORT=8787
HOST=0.0.0.0

# Shared secret the app must send as the x-proxy-token header. Set this
# whenever the proxy is reachable from anything other than your own machine.
PROXY_TOKEN=

SONIOX_API_KEY=
ELEVENLABS_API_KEY=
SPEECHMATICS_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPGRAM_API_KEY=

# --- Data-processing region (defaults shown) -------------------------------
# SONIOX_BASE_URL=https://api.soniox.com            # EU: https://api.eu.soniox.com (request access; separate project + key)
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io     # EU: https://api.eu.residency.elevenlabs.io (Enterprise only)
# SPEECHMATICS_BASE_URL=https://eu1.asr.api.speechmatics.com   # already EU
# OPENAI_BASE_URL=https://api.openai.com            # EU: https://eu.api.openai.com (needs sales approval)
# DEEPGRAM_BASE_URL=https://api.deepgram.com        # EU: https://api.eu.deepgram.com (same key)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# --- Model IDs (defaults verified against provider docs on 2026-11-12) ------
# SONIOX_ASYNC_MODEL=stt-async-v6
# ELEVENLABS_V2_MODEL=scribe_v2
# ELEVENLABS_V3_MODEL=scribe_v3
# SPEECHMATICS_MODEL=enhanced
# OPENAI_4O_MODEL=gpt-4o-transcribe
# OPENAI_MODEL=gpt-transcribe
# GEMINI_MODEL=gemini-3.5-transcribe
# DEEPGRAM_MODEL=nova-3

# --- Optional: transcript summaries (side-by-side comparison button) --------
# Uses a provider already listed above. No default model: pick one yourself.
# SUMMARY_PROVIDER=openai        # or gemini
# SUMMARY_MODEL=

# --- Optional ----------------------------------------------------------------
# MODELS_DIR=../models_out       # converted models served at /models/<id>/<file>
# ENABLE_MOCK=1                  # adds a "mock" engine that needs no key
